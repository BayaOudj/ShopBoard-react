# Empty uses the same-origin static demo catalog and generated product endpoints.
# Dev and Vite preview also support these local API test prefixes:
# VITE_API_BASE_URL=/delay/3000
# VITE_API_BASE_URL=/fail/500
# VITE_API_BASE_URL=/empty
# Set one in .env.local and restart Vite. Clear it to return to normal.
# These test prefixes are not emitted as production assets.
# An external HTTP(S) base URL needs the same API contract and appropriate CORS.
VITE_API_BASE_URL=
